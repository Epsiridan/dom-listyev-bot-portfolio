# Переменные окружения для локального запуска и Railway.
BOT_TOKEN=123456:replace_me
OPENAI_API_KEY=sk-proj-replace_me
GENERAL_GROUP_ID=-1001234567890
ADMIN_GROUP_ID=-1001234567893
PUBLIC_CHANNEL_ID=-1001234567891
PARTNER_CHANNEL_ID=-1001234567892
ADMIN_IDS=123456789,987654321

# ID топика «Проза и поэзия» в GENERAL_GROUP_ID, откуда бот забирает @DomListyevBot новый лист
CONTENT_SOURCE_THREAD_ID=123

# ID топиков в ADMIN_GROUP_ID
ADMIN_PROPOSALS_THREAD_ID=123
ADMIN_CONTESTS_THREAD_ID=456
ADMIN_REJECTS_THREAD_ID=789

# Когда публиковать одобренную очередь в PUBLIC_CHANNEL_ID, МСК
PUBLICATION_HOUR=18
PUBLICATION_MINUTE=0

# Необязательно: модель для команды /опознай@DomListyevBot.
# OPENAI_VISION_MODEL=gpt-5.6-sol

# Optional. By default the bot stores submissions.db in ./data.
# On Railway, set DATA_DIR to a persistent volume mount path,
# otherwise the publication queue can disappear after redeploy.
# DATA_DIR=data
# Необязательно: путь к локальному YAML с несекретными настройками.
# ENV всегда имеет приоритет над значением из YAML.
# CONFIG_FILE=config.yaml
# TIMEZONE=Europe/Moscow
